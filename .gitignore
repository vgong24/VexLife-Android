# VexLife-Android local/build state
#
# Keep source, contracts, and intentional configuration in Git.
# Keep machine-local IDE, SDK, cache, build, and signing state out.

# Gradle / Kotlin local state
.gradle/
.kotlin/
**/build/

# Android SDK / machine-local configuration
local.properties

# Android Studio / IntelliJ local project state
#
# Keep machine-local IDE state ignored, but admit the one repository-owned file that teaches
# Android Studio which optional developer-productivity plugin this project expects.
.idea/*
!.idea/externalDependencies.xml
*.iml

# Native/build intermediates
captures/
.externalNativeBuild/
.cxx/

# Packaged outputs
*.apk
*.aab
output-metadata.json

# Local logs / profiles
*.log
*.hprof

# Signing / machine credentials
*.jks
*.keystore

# Optional service configuration must be admitted deliberately
google-services.json

# OS residue
.DS_Store
Thumbs.db
